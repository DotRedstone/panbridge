# 真实夸克端到端测试配置示例
# 复制本文件为项目根目录下的 .env.quark（已被 .gitignore 排除），并填入真实值。
#
# 安全提示：此文件包含你的夸克账号 Cookie，切勿提交到 Git 或发送给他人。

# 夸克账号 Cookie（浏览器登录 pan.quark.cn 后从开发者工具复制）
PANBRIDGE_QUARK_COOKIE=

# 凭据加密主密钥（与运行服务时使用同一个）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
PANBRIDGE_SECRET_KEY=

# 一个有效的夸克分享链接（含提取码）
# 建议使用包含小文件的分享，便于快速验证下载
PANBRIDGE_QUARK_SHARE=https://pan.quark.cn/s/xxxx 提取码: xxxx
