# PanBridge 配置示例
# 复制为 .env 并按需修改。生产环境务必设置 API_KEY。

# API 鉴权密钥（为空则本机免鉴权，仅限开发）
PANBRIDGE_API_KEY=

# 凭据加密主密钥（可选）
# 留空时首次运行会自动生成强随机密钥并保存到 ~/.config/panbridge/secret.key
# （权限 0600，已加入 .gitignore）。多进程/多机共享时再显式注入。
PANBRIDGE_SECRET_KEY=

# 数据库连接（默认 SQLite WAL）
PANBRIDGE_DATABASE_URL=sqlite+aiosqlite:///./panbridge.db

# 下载目录
PANBRIDGE_DOWNLOAD_DIR=./downloads

# 监听地址与端口
PANBRIDGE_BIND_HOST=127.0.0.1
PANBRIDGE_BIND_PORT=8000

# 任务并发与租约
PANBRIDGE_MAX_TASK_CONCURRENCY=4
PANBRIDGE_WORKER_LEASE_SECONDS=300
PANBRIDGE_MAX_RETRY_ATTEMPTS=3
